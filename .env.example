# 複製成 .env 後填入自己的值：cp .env.example .env

# --- Telegram 通知（留空則只印到 console，程式仍可正常執行）---
# 1. 跟 @BotFather 申請 bot 拿 token
# 2. 跟自己的 bot 說一句話，再開 https://api.telegram.org/bot<TOKEN>/getUpdates 取得 chat id
MOMO_TELEGRAM_TOKEN=
MOMO_TELEGRAM_CHAT_ID=

# --- 輪詢設定 ---
# 每一輪之間的間隔（秒）。預設 60s，程式強制下限 5s。
# 頻率過高對 momo 是負擔、對你是被封鎖風險，沒事別調低。
MOMO_POLL_INTERVAL=60

# 每輪加入的隨機抖動（秒），避免固定週期打點
MOMO_POLL_JITTER=5

# 同時併發的請求數上限
MOMO_CONCURRENCY=4

# 兩次請求之間的全域最小間隔（秒），節流用
MOMO_MIN_REQUEST_GAP=0.5

# --- 其他 ---
MOMO_DB_PATH=momo_watch.db
MOMO_HTTP_TIMEOUT=10
MOMO_LOG_LEVEL=INFO

# --- Phase 2：下單流程（需要 pip install -e ".[buy]"）---
# 流程設定檔。從 flow.example.toml 複製一份再填 selector。
MOMO_FLOW_PATH=flow.toml

# 登入 cookie 存放位置。跑 `momo-watch login` 產生。
# ⚠️ 這個檔案等同帳號憑證，別提交進 git、別放共用目錄。
MOMO_STORAGE_STATE=storage_state.json

MOMO_SCREENSHOT_DIR=screenshots

# 監控與下單時是否用無頭瀏覽器。`login` 指令一律開有畫面的視窗。
MOMO_HEADLESS=true

# 容器裡預裝 chromium 且版本跟 playwright 套件對不上時，指定執行檔路徑
# MOMO_BROWSER_PATH=/opt/pw-browsers/chromium

# 校時伺服器（國家時間與頻率標準實驗室）
MOMO_NTP_SERVER=time.stdtime.gov.tw
